# Copy to .env.local (never commit .env.local). On Vercel: Project -> Settings -> Environment Variables.

# Server-side GitHub token (fine-grained, read-only). Needed for:
#  - the contribution graph (GraphQL API has no anonymous access),
#  - the "Latest on GitHub" block (anonymous REST limit is 60 req/h per IP and Vercel IPs are shared).
# Without it the site still builds and works; the blocks show a calm "temporarily unavailable" state.
GITHUB_TOKEN=
GITHUB_USERNAME=ruffbuff

